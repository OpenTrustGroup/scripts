set -e

function usage {
  cat <<END
usage: bootstrap [nebula|trusty|nebula-<release_branch>] [args of 'jiri update', ex. -v]

Bootstrap a Fuchsia development environment for the given layer. Defaults to
boostraping at the topaz layer. For more information about the Fuchsia layer
cake, see <https://fuchsia.googlesource.com/docs/+/master/development/source_code/layers.md>.
END
}

if [[ $# -gt 2 ]]; then
  usage
  exit 1
fi

layer=${1:-nebula}; shift

declare manifest_name=""
declare manifest_file=""
declare manifest_url=""
declare manifest_branch=""
declare gerrit_hostname="gerrit"

if [[ "${layer}" == "nebula" ]]; then
  manifest_name="manifest"
  manifest_file="cci/nebula-main"
  manifest_url="ssh://gerrit:29418/manifest"
  manifest_branch="master"
elif [[ "${layer}" == "trusty" ]]; then
  manifest_name="manifest"
  manifest_file="trusty"
  manifest_url="ssh://gerrit:29418/manifest"
  manifest_branch="grtos"
elif [[ "${layer}" =~ "nebula-" ]]; then
  manifest_name="manifest"
  manifest_file="cci/${layer}"
  manifest_url="ssh://gerrit:29418/manifest"
  manifest_branch="master"
else
  usage
  exit 1
fi

# The fetched script will
# - create "layer" directory if it does not exist,
# - download "jiri" command to "fuchsia/.jiri_root/bin"
#curl -s "http://${gerrit_url}/jiri/+/master/scripts/bootstrap_jiri?format=TEXT" | base64 --decode | bash -s "${layer}"

mkdir -p "${layer}/.jiri_root/bin"

pushd "${layer}/.jiri_root/bin" > /dev/null
FILE=jiri && git archive --remote=ssh://${gerrit_hostname}:29418/scripts.git nebula:jiri ${FILE} | tar -x > ${FILE} 2>&1
FILE=cipd && git archive --remote=ssh://${gerrit_hostname}:29418/scripts.git nebula:jiri ${FILE} | tar -x > ${FILE} 2>&1
popd > /dev/null

cd "${layer}"
.jiri_root/bin/jiri import -name="${manifest_name}" -remote-branch="${manifest_branch}" "${manifest_file}" "${manifest_url}"
.jiri_root/bin/jiri update -autoupdate=false ${@}

.jiri_root/bin/jiri runp "git remote get-url origin | sed 's/gerrit/gerrit-review/' | xargs git remote set-url --push origin"

echo > "setenv.sh" "\
export PATH=$PWD/prebuilts/gcc-linaro-7.5.0-2019.12/bin:$PATH
export PATH=$PWD/.jiri_root/bin:$PATH"

chmod +x setenv.sh

if [[ "${layer}" == "trusty" ]]; then
  echo "# generated by bootstrap" > .config
  echo "TEE=${layer}" >> .config
fi

echo "Done creating ${layer} development environment at \"$(pwd)\"."
echo "Recommended: source setenv.sh"

