#!/bin/bash

## usage: fx gdb file

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh
fx-config-read

if [[ $# -eq 0 ]]; then
  fx-command-help
  exit 1
fi

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/debug_utils.sh
target_file=$(find_file_with_debug_symbol $1)

if [[ ! -n ${target_file} ]]; then
  echo "File not found"
  exit 1
fi

readonly GCC_TOOLCHAIN_PATH="$(dirname ${LINARO_AARCH64_CROSS_COMPILE})/../"
${GCC_TOOLCHAIN_PATH}/bin/aarch64-linux-gnu-gdb ${target_file}
