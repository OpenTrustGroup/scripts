### build arm-trusted-firmware

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh
fx-config-read

readonly ATF_BUILDROOT="${FUCHSIA_OUT_DIR}/build-atf"
readonly TOOLCHAIN_PREFIX="${LINARO_AARCH64_CROSS_COMPILE}"
readonly LINUX_BUILDROOT="${FUCHSIA_OUT_DIR}/build-linux"
readonly TRUSTY_BUILDROOT="${FUCHSIA_OUT_DIR}/build-trusty"
readonly BL33_BIN="${ZIRCON_BUILD_DIR}/qemu-zircon.bin"
readonly ROOTFS_BUILDROOT="${FUCHSIA_OUT_DIR}/build-linux-rootfs"

declare BL32_BIN=""
declare BL32_EXTRA1_BIN=""
declare BL32_EXTRA2_BIN=""
declare SPD=""
declare FFA_ENABLE="0"
BL32_BIN="${ZIRCON_BUILD_DIR}/qemu-zircon.bin"
declare QEMU_USE_GIC_DRIVER="QEMU_GICV3"

if [[ "${TEE_SPD}" == "nebula" ]]; then
  SPD="nebula"
elif [[ "${TEE_SPD}" == "optee" ]]; then
  SPD="opteed"
  FFA_ENABLE="1"
else
  SPD="none"
fi

if [[ "${FFA_ENABLE}" = "1" ]]; then
  SPD="spmd"
  declare SPMC_AT_EL3=1
  declare SPMD_SPM_AT_SEL2=0
  declare QEMU_TOS_FW_CONFIG_DTS="../prebuilts/optee/spmc_el3_manifest.dts"
  declare ENABLE_SVE_FOR_SWD=1
fi

if [[ "${TEE}" = "gzos" ]]; then
  BL32_BIN="${ZIRCON_BUILD_DIR}/zircon.bin"
  BL32_EXTRA1_BIN="${FUCHSIA_BUILD_DIR}/bootdata-blobstore-${ZIRCON_PROJECT}.bin"
  BL32_EXTRA2_BIN=""
  SPD=trusty
elif [[ "${TEE}" = "trusty" ]]; then
  BL32_BIN="${TRUSTY_BUILDROOT}/lk.bin"
  SPD=trusty
fi

JOBS=`getconf _NPROCESSORS_ONLN` || {
  Cannot get number of processors
  exit 1
}

set -eo pipefail; [[ "${TRACE}" ]] && set -x


declare VERBOSE="${VERBOSE:-0}"
declare CLEAN="${CLEAN:-false}"
declare PLATFORM="${PLATFORM:-qemu}"
declare ATF_FLAGS=""
declare DEBUG_BUILD="0"
declare OPTIMIZE_BUILD="0"
declare ARM_ARCH_MAJOR="8"
declare ARM_ARCH_MINOR="0"

#  0 - LOG_LEVEL_NONE
# 10 - LOG_LEVEL_ERROR
# 20 - LOG_LEVEL_NOTICE (default for DEBUG=0)
# 30 - LOG_LEVEL_WARNING
# 40 - LOG_LEVEL_INFO (default for DEBUG=1)
# 50 - LOG_LEVEL_VERBOSE
declare LOG_LEVEL="40"

usage() {
  printf '%s: [-c] [-v] [-d] [-p platform]\n' "$0"
  printf '  -c            clean & build\n'
  printf '  -v            show verbose compiling messages\n'
  printf '  -d            debug build (images with debug info), default: release build\n'
  printf '  -n            set SPD as none\n'
  printf '  -o            enable GCC O0 option\n'
  printf '  -g            configure gic version\n'
  printf '  -p [platform] select which platform to build, default: %s\n' "${PLATFORM}"
}

while getopts "chp:vdnog:" opt; do
  case "${opt}" in
    c) CLEAN="true" ;;
    h) usage ; exit 0 ;;
    p) PLATFORM="${OPTARG}" ;;
    v) VERBOSE="1" ;;
    d) DEBUG_BUILD="1" ;;
    n) SPD="none" ;;
    o) OPTIMIZE_BUILD="1" ;;
    g)
      [[ "OPTARG" -eq "2" ]] && QEMU_USE_GIC_DRIVER="QEMU_GICV2"
      ;;
    *) usage 1>&2 ; exit 1 ;;
  esac
done

if [[ "${ATF_VERSION}" == "1.4" ]]; then
  readonly ATF_PATH="${FUCHSIA_DIR}/arm-trusted-firmware"
  ARM_ARCH_MAJOR="8"
  ARM_ARCH_MINOR="0"
elif [[ "${ATF_VERSION}" == "2.10" ]]; then
  readonly ATF_PATH="${FUCHSIA_DIR}/trusted-firmware-a"
  ARM_ARCH_MAJOR="8"
  ARM_ARCH_MINOR="1"
else
  echo "Unknown ATF version: ${ATF_VERSION}"
  exit 1
fi

if [[ -n "${CCACHE_DIR}" ]] && [[ -d "${CCACHE_DIR}" ]]; then
  export CROSS_COMPILE="$(which ccache) ${TOOLCHAIN_PREFIX}"
else
  export CROSS_COMPILE="${TOOLCHAIN_PREFIX}"
fi

if [[ "${CLEAN}" = "true" ]]; then
  echo "Cleaning arm-trusted-firmware..."
  rm -rf -- "${ATF_BUILDROOT}"
fi

if [[ "${DEBUG_BUILD}" = "1" ]]; then
  declare VARIANT="debug"
else
  declare VARIANT="release"
fi

if [[ "${OPTIMIZE_BUILD}" = "1" ]]; then
  declare OPTIMIZE="-O0 -gdwarf-2"
else
  declare OPTIMIZE=""
fi

echo "Building arm-trusted-firmware..."
rm -rf ${ATF_BUILDROOT}
ATF_FLAGS="${ATF_FLAGS} BL32=${BL32_BIN} BL33=${BL33_BIN}"
ATF_FLAGS="${ATF_FLAGS} BL32_EXTRA1=${BL32_EXTRA1_BIN} BL32_EXTRA2=${BL32_EXTRA2_BIN}"
if [[ "${FFA_ENABLE}" = "1" ]]; then
ATF_FLAGS="${ATF_FLAGS} SPMC_AT_EL3=${SPMC_AT_EL3} SPMD_SPM_AT_SEL2=${SPMD_SPM_AT_SEL2} QEMU_TOS_FW_CONFIG_DTS=${QEMU_TOS_FW_CONFIG_DTS} ENABLE_SVE_FOR_SWD=${ENABLE_SVE_FOR_SWD}"
fi
ATF_FLAGS="${ATF_FLAGS} PLAT=${PLATFORM} SPD=${SPD} "
ATF_FLAGS="${ATF_FLAGS} ARM_ARCH_MAJOR=${ARM_ARCH_MAJOR} ARM_ARCH_MINOR=${ARM_ARCH_MINOR}"
ATF_FLAGS="${ATF_FLAGS} ARM_TSP_RAM_LOCATION=tdram DEBUG=${DEBUG_BUILD} LOG_LEVEL=${LOG_LEVEL} BL32_RAM_LOCATION=tdram"
ATF_FLAGS="${ATF_FLAGS} BUILD_BASE=${ATF_BUILDROOT} V=${VERBOSE}"
ATF_FLAGS="${ATF_FLAGS} QEMU_USE_GIC_DRIVER=${QEMU_USE_GIC_DRIVER}"

cd ${ATF_PATH}
CFLAGS=${OPTIMIZE} make -C ${ATF_PATH} ${ATF_FLAGS} all fip

echo "Creating symbolic link to BL32 and BL33 boot images"
rm -f ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT}/bl32*.bin
rm -f ${ATF_BUILDROOT}/bl33.bin
rm -f ${ATF_BUILDROOT}/images

[[ ! -z "${BL32_BIN}" ]] && ln -sf ${BL32_BIN} ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT}/bl32.bin
[[ ! -z "${BL32_EXTRA1_BIN}" ]] && ln -sf ${BL32_EXTRA1_BIN} ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT}/bl32_extra1.bin
[[ ! -z "${BL32_EXTRA2_BIN}" ]] && ln -sf ${BL32_EXTRA2_BIN} ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT}/bl32_extra2.bin
ln -sf ${BL33_BIN} ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT}/bl33.bin
ln -sf ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT} ${ATF_BUILDROOT}/images
# Linux
ln -sf ${LINUX_BUILDROOT}/arch/arm64/boot/Image ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT}/bl33_extra1.bin
if [[ "${TEE_SPD}" == "optee" ]]; then
  ln -sf ${FUCHSIA_DIR}/prebuilts/optee/rootfs.cpio.gz ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT}/bl33_extra2.bin
  if [[ "${FFA_ENABLE}" = "1" ]]; then
    ln -sf ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT}/fdts/spmc_el3_manifest.dtb ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT}/tos_fw_config.dtb
  fi
else
  ln -sf ${ROOTFS_BUILDROOT}/filesystem.cpio.gz ${ATF_BUILDROOT}/${PLATFORM}/${VARIANT}/bl33_extra2.bin
fi

ls -l ${ATF_BUILDROOT}/images/bl3*.bin
