# make customized SDK for third-party developers.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/image_build_vars.sh
source "${FUCHSIA_DIR}/buildtools/vars.sh"

set -e; [[ "${TRACE}" ]] && set -x

# options:
# -o : output path
# -t : with two toolchains for ree and hee.
function help()
{
    echo "Usage: export mini environent for garnet development"
    echo "  <-o dir>: directory to output devkit."
    echo "  [-h]: show help."
}

OUTPUT_DIR=
HEADERS_ONLY=0
V="${TRACE:-}" # Controls rsync verbosity

[[ -n ${V} ]] && V="-v"

while getopts 'o:t' OPT; do
    case $OPT in
        o)
            OUTPUT_DIR="$(realpath $OPTARG)";;
        t)
            HEADERS_ONLY=1;;
        h)
            help
            exit 0;;
        ?)
            help
            exit 1;;
    esac
done
shift $(($OPTIND - 1))

# check options
if [ -z "$OUTPUT_DIR" ]; then
    echo "Please set output dir by \"-o\"."
    exit 1
fi

rename_files() {
    local dir="${1:-.}"   # default to current directory if not specified

    find "$dir" -type f -name "*.devkit" | while read -r file; do
        local newname="${file%.devkit}"
        mv "$file" "$newname"
        echo "Renamed: $file -> $newname"
    done
}

copy_files() {
    local target="$1"
    shift
    local -n items="$1"  # nameref to array passed in
    shift

    # ensure target exists
    mkdir -p "$target"

    for src in "${items[@]}"; do
        if [ -d "$src" ]; then
            rsync -aR --exclude=".git" "$src" "$target/"
            echo "Copied directory $src -> $target/"
        elif [ -f "$src" ]; then
            rsync -aR "$src" "$target/"
            echo "Copied file $src -> $target/"
        else
            echo "Warning: $src does not exist, skipping."
        fi
    done
}


init_git_repo() {
    local target="$1"

    if [ ! -d "$target" ]; then
        echo "Error: Target folder '$target' does not exist."
        return 1
    fi

    cd "$target" || return 1

    if [ -d ".git" ]; then
        rm -fr .git
    fi
    git init

    # Add all files
    git add .

    # Commit
    git commit -m "Initial commit"
}

to_relative_path() {
    local outdir="$1/out"
    local builddir="$2"

    if [ ! -d "$outdir" ]; then
        echo "Error: Output folder '$outdir' does not exist."
        return 1
    fi

    for f in $(find $outdir -type f -name "bootfs.manifest"); do
        sed -i -r -e "s#${builddir}/out/[a-zA-Z0-9\-]+#\.#" $f
    done
}

