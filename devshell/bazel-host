source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh
fx-config-read

set -eo pipefail; [[ "${TRACE}" ]] && set -x

export PATH=$PATH:$GOSDK_HOME/bin
export PATH=$PATH:$LINARO_AARCH64_TOOLCHAIN_HOME/bin

pushd "${BAZEL_HOST_DIR}" > /dev/null

bazelisk build //:all \
  --action_env="GOCACHE=$(go env GOCACHE)" \

popd > /dev/null

# TODO: Remove backward compatible stuffs when all modules bazelized.

SYZKALLER_OUT=${BAZEL_HOST_OUT}/syzkaller
SYZKALLER_BIN=${SYZKALLER_OUT}/src/github.com/google/syzkaller/bin
ln -sf ${SYZKALLER_OUT} ${FUCHSIA_OUT_DIR}
# IMX device configurations, na: Non Android
cd ${SYZKALLER_BIN} && ln -sf linux_arm64 linux-na_arm64

fx-show-elapsed-time
