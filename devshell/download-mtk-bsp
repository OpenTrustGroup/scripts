### download MTK BSP

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh
fx-config-read

readonly MTK_ROOT="${FUCHSIA_DIR}/mtk"
readonly MTK_BSP="${MTK_ROOT}/mtk-bsp"

JOBS=`getconf _NPROCESSORS_ONLN` || {
  Cannot get number of processors
  exit 1
}

set -eo pipefail; [[ "${TRACE}" ]] && set -x

mkdir -p ${MTK_ROOT}

cd ${MTK_ROOT}
if [ ! -d "${MTK_BSP}" ]; then
  echo "Downloading MTK BSP setup package"
  git clone ssh://gerrit:29418/external/mtk/mtk-bsp
  echo "Finished."
else
  echo "MTK BSP package already existed"
fi

cat > ${MTK_BSP}/env.sh << EOF
### Generated by fx download-mtk-bsp

#!/bin/bash

export NEBULA_ROOT="${FUCHSIA_DIR}"
export NEBULA_DEBUG_IMAGE="${FUCHSIA_DIR}/out/arm64/bootdata-combo-mtkv8-p60.bin"
export NEBULA_RELEASE_IMAGE="${FUCHSIA_DIR}/out/arm64/bootdata-combo-mtkv8-p60-rel.bin"
EOF

chmod +x ${MTK_BSP}/env.sh

echo "MTK BSP path: ${MTK_BSP}"
