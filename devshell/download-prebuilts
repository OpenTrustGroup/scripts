### download tools, extract to prebuilts folder, and export vars in .prebults_config
## usage: fx download-rebuilts [-c]
##
##   -c      remove all files in prebuilts folder and then download
##

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh

# The absolute path to save ane extract prebuilts.
readonly PREBUILTS_ABS_ROOT="${FUCHSIA_DIR}/prebuilts"
# The relative path to save in .prebuilts_config
readonly PREBUILTS_REL_ROOT="prebuilts"

readonly SERVER_URL="http://www/components"

set -eo pipefail; [[ "${TRACE}" ]] && set -x

declare CLEAN="${CLEAN:-false}"

function update-prebuilts-config {
  echo >> "${PREBUILTS_CONFIG}" "${1}=${2}"
}

# usage: decompress-tool ${toolname} ${extension} ${exportname} ${toolpath}
function decompress-tool {
  local toolname="${1}"
  local extension="${2}"
  local exportname="${3}"
  local toolpath="${4}"

  if [ ! -d "${PREBUILTS_ABS_ROOT}/${toolname}" ]; then
    case "${extension}" in
      ".tar.xz" | ".tar.gz")
        echo "tar xf ${toolpath} ..."
        mkdir -p "${PREBUILTS_ABS_ROOT}/${toolname}"
        tar xf "${PREBUILTS_ABS_ROOT}/${toolpath}" -C "${PREBUILTS_ABS_ROOT}/${toolname}" --strip-components=1
        update-prebuilts-config "${exportname}" "${PREBUILTS_REL_ROOT}/${toolname}"
        ;;
      ".zip")
        echo "unzip -q -d ${toolpath} ..."
        unzip -q -d "${PREBUILTS_ABS_ROOT}" "${PREBUILTS_ABS_ROOT}/${toolpath}"
        update-prebuilts-config "${exportname}" "${PREBUILTS_REL_ROOT}/${toolname}"
        ;;
      *)
        echo "\"${extension}\" decompress not support."
        ;;
    esac
  else
    echo "${toolpath} already decompressed..."
    update-prebuilts-config "${exportname}" "${PREBUILTS_REL_ROOT}/${toolname}"
  fi
}

# usage: download-tool ${toolname} ${host} ${extension} ${exportname}
# NOTE: the actual filename on server should be "${toolname}-${host}.${extension}"
function download-tool {
  local toolname="${1}"
  local host="${2:+-$2}"
  local extension="${3:+.$3}"
  local exportname="${4}"
  local toolpath="${toolname}${host}${extension}"

  if [ ! -f "${PREBUILTS_ABS_ROOT}/${toolpath}" ]; then
    echo "Downloading ${toolpath} ..."

    local resp=$(curl --write-out %{http_code} -# -L "${SERVER_URL}/${toolpath}" -o "${PREBUILTS_ABS_ROOT}/${toolpath}")
    case ${resp} in
      200)
        echo "Download success."
        ;;
      *)
        echo "Download failed. (${resp})"
        rm "${PREBUILTS_ABS_ROOT}/${toolpath}"
        ;;
    esac
  else
    echo "${toolpath} already downloaded..."
  fi
  decompress-tool "${toolname}" "${extension}" "${exportname}" "${toolpath}"
}

while getopts "ch" opt; do
  case "${opt}" in
    c) CLEAN="true" ;;
    h) fx-command-help; exit 0 ;;
    *) fx-command-help; exit 1 ;;
  esac
done

if [[ "${CLEAN}" = "true" ]]; then
  echo "Cleaning prebuilts..."
  rm -rf -- "${PREBUILTS_ABS_ROOT}"
fi

mkdir -p "${PREBUILTS_ABS_ROOT}"

cat >"${PREBUILTS_CONFIG}" <<END
# Generated by "fx download-prebuilts".
END
download-tool "gcc-linaro-7.5.0-2019.12" "x86_64_aarch64-linux-gnu" "tar.xz" "LINARO_AARCH64_TOOLCHAIN_HOME"
download-tool "SP_Flash_Tool_v5.1922.00.100" "Linux" "zip" "FLASHTOOL_HOME"
download-tool "nodejs-10.16.1" "linux_x86_64" "zip" "NODEJS_HOME"
download-tool "go1.11.1" "linux-amd64" "tar.gz" "GOSDK_HOME"

download-tool "android-sdk" "linux_x86_64" "tar.gz" "ANDROID_SDK_HOME"
update-prebuilts-config "ANDROID_NDK_HOME" "${PREBUILTS_REL_ROOT}/android-sdk/ndk/21.1.6352462"

# Download optee prebuilt
download-tool "optee" "arm64" "tar.xz" "OPTEE_HOME"

# Download zircon prebuilt
echo "Downloading zircon prebuilt..."
cd ${FUCHSIA_DIR}/zircon && ./scripts/download-toolchain

# Update buildtools
echo "Updating buildtools..."
cd ${FUCHSIA_DIR}/buildtools && ./update.sh

