### build Linux cepheus kernel with clang

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh
fx-config-read

readonly LINUX_BUILDROOT="${FUCHSIA_OUT_DIR}/build-linux-cepheus"
readonly LINUX_PATH="${FUCHSIA_DIR}/linux-cepheus"
readonly LINUX_ARCH="arm64"
readonly SCRIPT_DIR="${FUCHSIA_DIR}/scripts"
readonly GCC_HOME="${FUCHSIA_DIR}/prebuilts/LinuxClang/gcc/"
readonly CLANG_HOME="${FUCHSIA_DIR}/prebuilts/LinuxClang/clang/"
readonly CROSS_COMPILE="aarch64-linux-android-"

JOBS=`getconf _NPROCESSORS_ONLN` || {
  Cannot get number of processors
  exit 1
}

set -eo pipefail; [[ "${TRACE}" ]] && set -x

declare VERBOSE="${VERBOSE:-0}"
declare CLEAN="${CLEAN:-false}"
declare PLATFORM="${PLATFORM:-qemu}"
declare LINUX_FLAGS="LOCALVERSION= O=${LINUX_BUILDROOT} ARCH=${LINUX_ARCH} CC=clang CLANG_TRIPLE=aarch64-linux-gnu- TEXT_OFFSET=0x10000 CROSS_COMPILE=${CROSS_COMPILE}"

usage() {
  printf '%s: [-c] [-v] [-p platform]\n' "$0"
  printf '  -c            clean & build\n'
  printf '  -v            show verbose compiling messages\n'
  printf '  -p [platform] select which platform to build, default: %s\n' "${PLATFORM}"
}

while getopts "chp:v" opt; do
  case "${opt}" in
    c) CLEAN="true" ;;
    h) usage ; exit 0 ;;
    p) PLATFORM="${OPTARG}" ;;
    v) VERBOSE="1" ;;
    *) usage 1>&2 ; exit 1 ;;
  esac
done

if [[ "${CLEAN}" = "true" ]]; then
  echo "Cleaning linux..."
  rm -rf -- "${LINUX_BUILDROOT}"
fi

echo "### Downloading Xiaomi_Kernel_OpenSource..."
if [[ ! -d "${LINUX_PATH}" ]]; then
  mkdir -p "${LINUX_PATH}"
  git clone ssh://gerrit:29418/Xiaomi_Kernel_OpenSource -b nebula "${LINUX_PATH}"
fi

echo "### Download GCC..."
if [[ ! -d "${GCC_HOME}" ]]; then
  mkdir -p "${GCC_HOME}"
  git clone ssh://gerrit:29418/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9 "${GCC_HOME}"
fi
export PATH=${GCC_HOME}/bin/:$PATH

echo "### Download CLANG..."
if [[ ! -d "${CLANG_HOME}" ]]; then
  mkdir -p "${CLANG_HOME}"
  git clone ssh://gerrit:29418/platform/prebuilts/clang/host/linux-x86 "${CLANG_HOME}"
fi
export PATH=${CLANG_HOME}/clang-r349610/bin:$PATH

echo "Building linux-cepheus-4.14..."

mkdir -p ${LINUX_BUILDROOT}
cd ${LINUX_PATH} && make ${LINUX_FLAGS} cepheus_user_sim_defconfig
make -j ${JOBS} V=${VERBOSE} ${LINUX_FLAGS}

mkdir -p ${FUCHSIA_BUILD_DIR}/linux
ln -sf ${LINUX_BUILDROOT}/arch/arm64/boot/Image ${FUCHSIA_BUILD_DIR}/linux/Image
