### build third_party/ree-trusty by Android NDK
## usage: [TRACE=1] fx build-ree-trusty-ndk
##
##   TRACE=1    show detailed ndk build logs.
##

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh
fx-config-read

JOBS=`getconf _NPROCESSORS_ONLN` || {
  Cannot get number of processors
  exit 1
}

set -eo pipefail; [[ "${TRACE}" ]] && set -x

readonly NDK_PROJ_ROOT="${FUCHSIA_DIR}/third_party/ree-trusty"
readonly NDK_OUT="${FUCHSIA_OUT_DIR}/build-ree-trusty-ndk"

while getopts "h" opt; do
  case "${opt}" in
    h) fx-command-help ; exit 0 ;;
    *) fx-command-help 1>&2 ; exit 1 ;;
  esac
done
shift $(($OPTIND - 1))

echo "###############################################################"
echo "Building ree-trusty by NDK..."
echo "###############################################################"

make -f ${NDK_PROJ_ROOT}/Android.mk \
    NDK_PROJ_ROOT=${NDK_PROJ_ROOT} \
    NDK_HOME=${ANDROID_NDK_HOME} \
    NDK_OUT=${NDK_OUT} \
    JOBS=${JOBS} \
    V=${TRACE:-0} \

