# Test Secure Time, source is in "//third_party/hee-trusty/nbl_time/test".

# install exe into HEE
set ha_id 01d4cecc-fbc4-43d8-801c-8e5fdf35f7a3
exec bash -c "$NBL_SDK_PATH/run/install-test-suite.sh -e test_time -a $env(FUCHSIA_IP) -i $ha_id"
# set the run command in HEE.
set cmd "nbl_daemon -l $ha_id"

send -i $ree "$cmd\r"
# Example(copy log examples from NBL-0102-nsc-nss.exp):
### Failed case.
# [  FAILED  ] TestNSSNormalTest/NSSNormalTest.RandomWrite/3, where GetParam() = 2 (18 ms)
# [  PASSED  ] 49 tests.
# [  FAILED  ] 1 tests, listed below:
# [  FAILED  ] TestNSSNormalTest/NSSNormalTest.RandomWrite/0, where GetParam() = -1
#  4 FAILED TESTS
### Success case.
# [  PASSED  ] 2 tests.
### So it's NOT easy to distinguish clearly, so I add some message at end of app.
set timeout 120
expect {
    -i $ree timeout {
        printf "TIMEOUT !!!\n"
        exit 1
    }

    "ALL TESTS FAILED." {
        printf "$cmd FAILED !!!\n"
        exit 1
    }

    # DummyRead to avoid expect log full from the other world
    -i $console "$ " {
        exp_continue
    }

    -i $ree "ALL TESTS SUCCEEDED."
}
