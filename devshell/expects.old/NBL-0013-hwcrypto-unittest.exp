if { "$env(USE_RELEASE)" == "true" } {
    # install exe into HEE
    set ha_id ab742471-d6e6-4806-85f6-0555b024f4da
    exec bash -c "$NBL_SDK_PATH/run/install-test-suite.sh -e hwcrypto-unittest -a $env(FUCHSIA_IP) -i $ha_id"
    # set the run command in HEE.
    set cmd "nbl_daemon -l $ha_id"
} else {
    set cmd "nblruncmd /system/test/hwcrypto/hwcrypto-unittest"
}
send -i $ree "$cmd\r"
# Example: The first line is in testcase, the second line is end of all tests whether or not success or failed.
# hwcrypto_unittest: 358: run_hwrng_stats_test: FAILED
# hwcrypto_unittest: 397: hwcrypto-unittest: complete!
set timeout 60
expect {
    -i $ree timeout {
        printf "TIMEOUT !!!\n"
        exit 1
    }

    "*: FAILED" {
        printf "$cmd FAILED !!!\n"
        exit 1
    }

    # DummyRead to avoid expect log full from the other world
    -i $console "$ " {
        exp_continue
    }

    -i $ree "hwcrypto-unittest: complete!"
}
