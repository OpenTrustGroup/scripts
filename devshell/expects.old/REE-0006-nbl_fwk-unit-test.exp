send -i $ree "$cmd\r"
set timeout 30
expect {
    -i $ree timeout {
        printf "TIMEOUT !!!\n"
        exit 1
    }

    -i $ree -re {Conditions failed:  [1-9][0-9]*} {
        printf "$cmd FAILED !!!\n"
        exit 1
    }

    # DummyRead to avoid expect log full from the other world
    -i $console "$ " {
        exp_continue
    }

    -i $ree "All tests PASSED"
}

