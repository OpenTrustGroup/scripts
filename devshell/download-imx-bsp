### download i.MX BSP

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh
fx-config-read

readonly NXP_ROOT="${FUCHSIA_DIR}/nxp"
readonly IMX_BSP="${NXP_ROOT}/imx-bsp"

JOBS=`getconf _NPROCESSORS_ONLN` || {
  Cannot get number of processors
  exit 1
}

set -eo pipefail; [[ "${TRACE}" ]] && set -x

mkdir -p ${NXP_ROOT}

cd ${NXP_ROOT}
if [ ! -d "${IMX_BSP}" ]; then
  echo "Downloading i.MX BSP setup package"
  git clone ssh://gerrit:29418/external/imx/imx-bsp
  echo "Finished."
else
  echo "i.MX BSP package already existed"
fi

cat > ${IMX_BSP}/env.sh << EOF
### Generated by fx download-imx-bsp

#!/bin/bash

export NEBULA_ROOT="${FUCHSIA_DIR}"
export NEBULA_DEBUG_IMAGE="${FUCHSIA_DIR}/out/arm64/bootdata-combo-imx8mm-evk.bin"
export NEBULA_RELEASE_IMAGE="${FUCHSIA_DIR}/out/arm64/bootdata-combo-imx8mm-evk-rel.bin"
EOF

chmod +x ${IMX_BSP}/env.sh

echo "i.MX BSP path: ${IMX_BSP}"
