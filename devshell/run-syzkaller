### Run syz-manager
## usage: fx run-syzkaller [options] -t target
##  -t  run syzkaller on specified target
##       - nebula                      : device loaded w/ debug nebula image, runs in fuzzer mode
##       - cepheus-dbg-tw              : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - cepheus-dbg-sy              : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - p80-dbg                     : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - p60-dbg                     : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - p60-tee-dbg                 : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - p60-tee-benchmark-dbg       : device flashed w/ debug nebula image, runs benchmark tests in oneshot mode
##       - urovo-tee-dbg               : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - urovo-tee-benchmark-dbg     : device flashed w/ debug nebula image, runs benchmark tests in oneshot mode
##       - p85-tee-dbg                 : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - p85-tee-benchmark-dbg       : device flashed w/ debug nebula image, runs benchmark tests in oneshot mode
##       - imx8qxp-linux-dbg           : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - imx8qxp-tee-dbg             : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - imx8qxp-tee-benchmark-dbg   : device flashed w/ debug nebula image, runs benchmark tests in oneshot mode
##       - imx8qm-tee-dbg              : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - imx8qm-tee-benchmark-dbg    : device flashed w/ debug nebula image, runs benchmark tests in oneshot mode
##       - ecarx-dbg                   : device flashed w/ debug nebula image, runs debug tests in oneshot mode
##       - ecarx-tee-benchmark-dbg : device flashed w/ debug nebula image, runs benchmark tests in oneshot mode
##  -u  run specified syzkaller tests, ex. -u pkg/mgrconfig
##  -v  num  verbosity

set -eo pipefail; [[ "${TRACE}" ]] && set -x

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
readonly ROOT_DIR="$(dirname "${SCRIPT_DIR}")"

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh
fx-config-read

function usage {
  fx-command-help
  exit 1
}

while getopts "t:u:v:" opt; do
  case "${opt}" in
    t) TARGET="${OPTARG}" ;;
    u) GOTESTPATH="${OPTARG}" ;;
    v) VERBOSE="${OPTARG}" ;;
    *) usage 1>&2 ; exit 1 ;;
  esac
done

declare VERBOSE="${VERBOSE:-0}"
declare GOTEST="${GOTEST:-0}"

export GOROOT="${FUCHSIA_OUT_DIR}/syzkaller/go"
export GOPATH="${FUCHSIA_OUT_DIR}/syzkaller"
export SYZKALLER_GOROOT=${GOPATH}/src/github.com/google/syzkaller
export PATH=${GOROOT}/bin:${PATH}

if [[ -n "${GOTESTPATH}" ]]; then
  cd ${SYZKALLER_GOROOT}/${GOTESTPATH}
  go test
  cd -
  exit 0
fi

declare CFG="${FUCHSIA_BUILD_DIR}/${TARGET}.syzkaller.cfg"

case ${TARGET} in
nebula)
cat > "${CFG}" << EOF
{
	"name": "${TARGET}",
	"target": "fuchsia/arm64",
	"http": "localhost:8989",
	"workdir": "${GOPATH}/working_dir.${TARGET}",
	"syzkaller": "${SYZKALLER_GOROOT}",
	"sshkey": "${FUCHSIA_BUILD_DIR}/ssh-keys/id_ed25519",
	"reproduce": false,
	"cover": false,
	"procs": 8,
	"type": "nebula"
}
EOF
