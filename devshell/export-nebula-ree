### Export Nebula REE artifacts for Android BSP integration

## usage: fx export-nebula-ree -o <output_path> [-f] [-h]

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh
fx-config-read

set -eo pipefail; [[ "${TRACE}" ]] && set -x

readonly NEBULA_DIR="${FUCHSIA_DIR}"
declare output_path=""
declare full_set_sdk="false"

while getopts "fho:" opt; do
  case "${opt}" in
    o) output_path=${OPTARG} ;;
    f) full_set_sdk="true" ;;
    h) fx-command-help; exit 0 ;;
    *) fx-command-help; exit 1 ;;
  esac
done

if [ -z "${output_path}" ]; then
  echo "Error: invalid options"
  fx-command-help
  exit 1
fi

