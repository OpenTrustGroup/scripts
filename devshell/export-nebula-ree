function copy_files() {
  local copy_list="${1}"
  local exclude_list="${2}"
  local rsync_options="-a --delete"

  if [[ "${TRACE}" ]]; then
    rsync_options+=" -v"
  fi

  for paths in ${copy_list}; do
    IFS=':'
    tmp_arr=($paths)
    unset IFS
    src="${NEBULA_DIR}/${tmp_arr[0]}"
    exclude_str="${tmp_arr[1]}"
    dst="${output_path}/${tmp_arr[2]}"
    dst_parent_dir="$(dirname "${dst}")"
    exclude_options=""

    # Add common exclude options
    for p in ${exclude_list}; do
      exclude_options+="--exclude '${p}' "
    done

    # Add per-entry exclude options
    if [[ -n "${exclude_str}" ]]; then
      IFS=','
      tmp_arr1=($exclude_str)
      unset IFS
      for p in "${tmp_arr1[@]}"; do
        exclude_options+="--exclude '${p}' "
      done
    fi

    if [[ ! -d "${dst_parent_dir}" ]]; then
      mkdir -p "$(dirname "${dst}")"
    fi
    eval rsync ${rsync_options} ${exclude_options} "${src}" "${dst}"
  done
}

function gen_ta_makefile() {
  local ta_name="${1}"
  local output_path="${2}"

  echo -e "\nGenerating ${ta_name} TA makefile: ${output_path}"
  cat > ${output_path} << EOF
SDK_HOME ?= ../../..
TARGET = ${ta_name}
SD_PRIVILEGE_FILE_ARG=--sd_privilege_file sd.privilege
MK_PATH := \$(dir \$(abspath \$(lastword \$(MAKEFILE_LIST))))

.PHONY: clean all provision

clean:
	rm -rf \${LOCAL_OBJS_DIR}

all:
	@echo "ignore compiling prebuilt TA: \${TARGET}"

provision:
	mkdir -p \${LOCAL_OBJS_DIR}/
	\${SDK_HOME}/run/otrp/provision_tool/provision_create_ha_by_config.sh -c \${CONFIG_FOLDER_PATH} -e \${MK_PATH}/\${TARGET} -o \${LOCAL_OBJS_DIR}/provision \${SD_PRIVILEGE_FILE_ARG}

include \${SDK_HOME}/make/hee-dummy.mk
EOF
}

