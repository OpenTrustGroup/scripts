echo "# filelist-tee-common /end" >> ${EXTRA_ROOTFS_FILELIST}


# Merge common and extra filelists and generate rootfs image
cd ${ROOTFS_BUILDROOT}

cat filelist-final.txt > filelist.tmp
cat ${EXTRA_ROOTFS_FILELIST} >> filelist.tmp

${LINUX_BUILDROOT}/usr/gen_init_cpio filelist.tmp | gzip > filesystem.cpio.gz

mkdir -p ${FUCHSIA_BUILD_DIR}/host_x64/linux
ln -sf ${ROOTFS_BUILDROOT}/filesystem.cpio.gz ${FUCHSIA_BUILD_DIR}/host_x64/linux/initrd.img
