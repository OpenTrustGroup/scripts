### Generate sha256 hash for given file

## usage: fx gen-sha256-hash <input-file> <output-binary>

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"/lib/vars.sh
fx-config-read

set -eo pipefail; [[ "${TRACE}" ]] && set -x

if [[ ! $# -eq 2 ]]; then
  fx-command-help
  exit 1
fi

sha256sum $1 | awk '{print "0: "$1}' | xxd -r -c 64 > $2
