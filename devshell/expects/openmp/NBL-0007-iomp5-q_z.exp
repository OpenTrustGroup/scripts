if { "$env(USE_RELEASE)" == "true" } {
    # TODO : There is NO "runtests" in release.
} else {
    # run test case in /system/test/iomp5. file name begin with q-z.
    set cmd "nblruncmd runtests -t ^\[q-z\].* /system/test/iomp5"
    send -i $ree "$cmd\r"
    set timeout 720
    expect {
        -i $ree timeout {
            printf "TIMEOUT !!!\n"
            exit 1
        }
        ## Print all test logs except "SUMMARY:..."
        #-i $console -re {^((?!SUMMARY)[^\n]*)\n} {
        #    printf "$expect_out(0,string)"
        #    exp_continue
        #}
        # "SUMMARY: Ran XX tests: N failed", N != 0
        -i $ree -re {SUMMARY:[^:]*:\s(?!0)[0-9]*\sfailed} {
            printf "$expect_out(0,string) FAILED !!!\n"
            exit 1
        }
        ## "SUMMARY: Ran XX tests: 0 failed"
        -i $ree -re {SUMMARY:[^:]*:\s(?=0)[0-9]*\sfailed} {
            printf "$expect_out(0,string)\n"
            exp_continue
        }

        # DummyRead to avoid expect log full from the other world
        -i $console "$ " {
            exp_continue
        }

        -i $ree "root@FVP:/ "
    }
}
