set file_name "ca2ta_nbl_benchmarks_trusty_channel_qemu"
set file_type "csv"

if { "$env(USE_RELEASE)" == "true" } {
} else {
    set cmd "nbl_benchmarks --benchmark_filter=TrustyChannel --benchmark_repetitions=10 --benchmark_out=/tmp/$file_name.$file_type --benchmark_out_format=$file_type --benchmark_color=false | tee /tmp/$file_name.console"
    send -i $ree "$cmd\r"

    set timeout 3600
    expect {
        -i $ree timeout {
            printf "TIMEOUT !!!\n"
            exit 1
        }

        # find "end" to save the all call stackes.
        -i $ree {*bt#*: end} {
            printf "$cmd FAILED !!!\n"
            exit 1
        }

        # DummyRead to avoid expect log full from the other world
        -i $console "$ " {
            exp_continue
        }

        -i $ree "root@FVP:/ "
    }

    spawn scp root@$env(FUCHSIA_IP):/tmp/$file_name.$file_type $env(FUCHSIA_OUT_DIR)/build-atf/qemu/release/$file_name.$file_type
    set spawn_console $spawn_id

    set timeout 10
    expect {
        -i $spawn_console timeout {
            printf "TIMEOUT !!!\n"
            exit 1
        }

        -i $spawn_console "Are you sure you want to continue connecting (yes/no)? " {
            send -i $spawn_console "yes\r"
            exp_continue
        }

        # DummyRead to avoid expect log full from the other world
        -i $console "$ " {
            exp_continue
        }
    }

    spawn scp root@$env(FUCHSIA_IP):/tmp/$file_name.console $env(FUCHSIA_OUT_DIR)/build-atf/qemu/release/$file_name.console
    set spawn_console $spawn_id

    set timeout 10
    expect {
        -i $spawn_console timeout {
            printf "TIMEOUT !!!\n"
            exit 1
        }

        -i $spawn_console "Are you sure you want to continue connecting (yes/no)? " {
            send -i $spawn_console "yes\r"
            exp_continue
        }

        # DummyRead to avoid expect log full from the other world
        -i $console "$ " {
            exp_continue
        }
    }
}
