            spawn sh -c "${SOC_TERM_PATH}/soc_term \$port 2>&1 | tee ${ARG_SDK_HOME}/serial-\$world-\$mypid.log"
            set spid \$spawn_id
            set timeout 30
            expect {
                timeout {
                    printf "serial-\$world-\$mypid:\$port connected...\n"
                    set port_found 1
                }
                -i \$spid "soc_term: bind: Address already in use" {
                    incr port
                }
            }
        }
        set ret(spid) \$spid
        set ret(port) \$port
        return [array get ret]
    }

