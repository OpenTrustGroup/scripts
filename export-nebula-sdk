dumplog() {
  while IFS= read -r line
  do
    echo "$line"
  done < "$1"
}

clean_sdk() {
  echo ""
  echo "Cleaning SDK..."
  cd $ARG_SDK_HOME/examples && make clean
  rm -f ${EXPECT_SCRIPT}
  rm -f ${ARG_SDK_HOME}/*.log
}

if [ "$RUN_TEST" == "false" ]; then
  echo ""
  echo "Ignore running test cases."
else
  echo ""
  echo "Start running test cases..."

  exec expect ${EXPECT_OPT} ${EXPECT_SCRIPT} & EXPECT_CPID="$!"
  wait -n "${EXPECT_CPID}" || exp_err="true"
  if [[ "${exp_err}" = "true" ]]; then
    qemulog="${ARG_SDK_HOME}/serial-qemu-${EXPECT_CPID}.log"
    heelog="${ARG_SDK_HOME}/serial-hee-${EXPECT_CPID}.log"
    reelog="${ARG_SDK_HOME}/serial-ree-${EXPECT_CPID}.log"
    teelog="${ARG_SDK_HOME}/serial-tee-${EXPECT_CPID}.log"
    echo "== ${PWD}/${qemulog}:"; dumplog "${qemulog}"; echo "== end of ${PWD}/${qemulog}:"
    echo "== ${PWD}/${teelog}:"; dumplog "${teelog}"; echo "== end of ${PWD}/${teelog}:"
    echo "== ${PWD}/${heelog}:"; dumplog "${heelog}"; echo "== end of ${PWD}/${heelog}:"
    echo "== ${PWD}/${reelog}:"; dumplog "${reelog}"; echo "== end of ${PWD}/${reelog}:"

    echo ""
    echo "Test FAILED"

    clean_sdk
    exit 1
  fi

  echo ""
  echo "Test OK"
fi

clean_sdk

