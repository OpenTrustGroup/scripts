# Export Nebula SDK

basepath=$(cd `dirname $0`; pwd)
set -eE;set -eo pipefail; [[ "${TRACE}" ]] && set -x; [[ "${TRACE_EXP}" ]] && EXPECT_OPT="-d"

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly NEBULA_DIR="$(dirname "${SCRIPT_DIR}")"

declare ARG_SDK_HOME=
declare BUILD_NEBULA="false"
declare CREATE_SDK="true"
declare RUN_TEST="true"
declare SOC_TERM=""

usage() {
  printf '%s -o <SDK_PATH> [-b|-c] [-N] [-T] [-h]\n' `basename "$0"`
  printf '  -o <SDK_PATH>   path of saving SDK, if exist, remove it.\n'
  printf '  [-b|-c]         do Nebula full build or clean build\n'
  printf '  -N              ignore creating SDK\n'
  printf '  -T              ignore running test cases\n'
  printf '  -h              show help.\n'
  printf '\n'
  printf 'default action: create SDK and run test cases\n\n'
}

while getopts "ho:NTbc" opt; do
  case "${opt}" in
    o) ARG_SDK_HOME="${OPTARG}" ;;
    N) CREATE_SDK="false" ;;
    T) RUN_TEST="false" ;;
    b) BUILD_NEBULA="full" ;;
    c) BUILD_NEBULA="clean" ;;
    h) usage 1>&2 ; exit 0 ;;
    *) usage 1>&2 ; exit 1 ;;
  esac
done

if [ -z "$ARG_SDK_HOME" ]; then
    echo "Please input SDK home, by \"-o\"."
    usage 1>&1 ; exit 1
fi


### 0. Build Nebula images ###
if [ "$BUILD_NEBULA" == "clean" ]; then
  echo ""
  echo "Start Nebula clean build..."
  rm -rf ${NEBULA_DIR}/out/*
  rm -rf ${NEBULA_DIR}/out/.bazel*
  ${SCRIPT_DIR}/fx set-venus venus-hee
  ${SCRIPT_DIR}/fx full-build
elif [ "$BUILD_NEBULA" == "full" ]; then
  echo ""
  echo "Start Nebula full build..."
  ${SCRIPT_DIR}/fx full-build
fi


### 1. Create Nebula SDK ###
if [ "$CREATE_SDK" == "true" ]; then
  echo ""
  echo "Start creating SDK..."

  if [ -d "$ARG_SDK_HOME" ]; then
      rm -rf $ARG_SDK_HOME
  fi
  mkdir -p $ARG_SDK_HOME

  ${SCRIPT_DIR}/fx make-sdk -o $ARG_SDK_HOME
fi

#### check document ####
